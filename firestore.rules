rules_version = '2';

// Security rules for the remote-session relay (docs/platform/REMOTE_SESSION_PLAN.md §3).
//
// Two parties reach this database and they are not equals:
//
//   * The participant's phone, signed in anonymously. It may READ one invite
//     (to check the link is still good) and CREATE one result against it. It
//     may never list, update, delete, or read anybody's results — including
//     its own, which it already has on the device.
//   * The helper's laptop, signed in as a real user. It owns the invites it
//     minted and reads the results addressed to it.
//
// The rules are the enforcement. The page is not: a browser page can be
// modified by whoever is holding it, so anything the consent screen promises
// has to be true here too.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function invite(token) {
      return get(/databases/$(database)/documents/invites/$(token)).data;
    }

    function inviteUsable(token) {
      let inv = invite(token);
      return inv != null
          && inv.revoked != true
          && inv.uses_left is int && inv.uses_left > 0
          && inv.expires_at is timestamp && inv.expires_at > request.time;
    }

    match /invites/{token} {
      // The participant reads exactly the invite whose token they hold. There
      // is no list rule on purpose: without one, the collection cannot be
      // enumerated, so a token is only useful to someone who was sent it.
      allow get: if signedIn();
      allow list: if false;

      // Only the helper who owns an invite may mint or change it.
      allow create: if signedIn()
                    && request.resource.data.helper_uid == request.auth.uid;
      allow update, delete: if signedIn()
                            && resource.data.helper_uid == request.auth.uid;
    }

    match /remote_results/{docId} {
      // Create-only, against a live invite, and never carrying media.
      // §4: metrics only — no video, no per-frame landmark arrays.
      allow create: if signedIn()
                    && inviteUsable(request.resource.data.invite_token)
                    && request.resource.data.keys().hasOnly(
                         ['invite_token', 'helper_uid', 'session'])
                    && request.resource.data.session.keys().hasOnly(
                         ['session_id', 'timestamp', 'test', 'mode', 'hand',
                          'duration_s', 'participant', 'device', 'metrics'])
                    && request.resource.data.helper_uid
                       == invite(request.resource.data.invite_token).helper_uid;

      // The participant cannot read back, amend, or withdraw an upload; the
      // helper reads what is addressed to them and clears it once filed.
      allow get, list: if signedIn()
                       && resource.data.helper_uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.helper_uid == request.auth.uid;
    }

    // ── Adam's portfolio site ───────────────────────────────────────────
    // A second Hosting site in this project (adam-chung-engineering-portfolio,
    // built from 桌面/Engineering Profolio) has a live editor that saves its
    // edits and pictures here. Anyone may read one document by name, since
    // they are what the public site shows. Only Adam, signed in with Google,
    // may write. The other side is that site's src/live.js and
    // src/editor/cloud.js. It shares nothing with the relay above.

    function isPortfolioOwner() {
      return signedIn()
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email == 'adamchung444@gmail.com'
          && request.auth.token.email_verified == true;
    }

    match /portfolio/{docId} {
      allow get: if true;
      allow create, update: if isPortfolioOwner()
                            && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
                            && request.resource.data.json is string;
      allow delete: if isPortfolioOwner();
    }

    // One uploaded picture each, as a data: URL under Firestore's 1 MB limit.
    match /portfolio_images/{imageId} {
      allow get: if true;
      allow create, update: if isPortfolioOwner()
                            && request.resource.data.keys().hasOnly(['data', 'width', 'height', 'createdAt'])
                            && request.resource.data.data is string
                            && request.resource.data.data.size() < 1000000;
      allow delete: if isPortfolioOwner();
    }

    // One document per page a visitor opens on the portfolio site (its
    // src/visits.js), so Adam can see whether a school has looked. Anyone may
    // add one, in this shape only, with short text fields and no IP address.
    // Nobody may change or delete one, and only Adam may read them; he does
    // so with that site's `npm run visits`, which uses his Firebase CLI login.
    function shortText(data, key) {
      return !(key in data) || (data[key] is string && data[key].size() <= 200);
    }

    match /portfolio_visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['page', 'referrer', 'link', 'session', 'city', 'region', 'country',
                          'network', 'domain', 'timezone', 'device', 'language'])
                    && request.resource.data.page is string
                    && shortText(request.resource.data, 'page')
                    && shortText(request.resource.data, 'referrer')
                    && shortText(request.resource.data, 'link')
                    && shortText(request.resource.data, 'session')
                    && shortText(request.resource.data, 'city')
                    && shortText(request.resource.data, 'region')
                    && shortText(request.resource.data, 'country')
                    && shortText(request.resource.data, 'network')
                    && shortText(request.resource.data, 'domain')
                    && shortText(request.resource.data, 'timezone')
                    && shortText(request.resource.data, 'device')
                    && shortText(request.resource.data, 'language');
      allow get, list: if isPortfolioOwner();
    }

    // Nothing else in this project is reachable from a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
